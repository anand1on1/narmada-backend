# R28.18. Server-side Render environment ONLY. Never add these to client config.js.
# Migration defaults to Auto mode but cannot generate/publish until this gate is true.
# Set true only on an approved deployed release, after GoDaddy bridge smoke checks.
AUTO_BLOGGER_ENABLED=false

# Reuse either existing server credential; CLAUDE_API_KEY has precedence.
# CLAUDE_API_KEY=
# ANTHROPIC_API_KEY=

# Research: reuse existing PERPLEXITY_API_KEY (Sonar) OR provide TAVILY_API_KEY.
# If both are configured, Tavily is used. No frontend keys, no mock production fallback.
# PERPLEXITY_API_KEY=
# TAVILY_API_KEY=

# Uses existing DATA_DIR persistent disk and existing admin-role authentication.
# API endpoints are fixed HTTPS; source pages restricted to manufacturer/government hosts.
# Default IST schedule: new 09:00, improve 13:00, new 17:00.
# Default budgets: 2 new / 1 improvement / 1 manual draft; 18 API call reservations,
# 300000 token reservations per day; 3 attempts/slot. Changes via admin controls.
# Research sources: at most 4 fetches/attempt, 2 retained, 6000 chars each.
# Generator uses existing claude-sonnet-4-5; research uses Sonar or Tavily basic.
