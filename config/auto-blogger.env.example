# R28.19. Server-side Render environment ONLY. Never add these to client config.js.
# Migration defaults to Auto mode but cannot generate/publish until this gate is true.
# Set true only on an approved deployed release, after GoDaddy bridge smoke checks.
AUTO_BLOGGER_ENABLED=false

# Reuse either existing server credential; CLAUDE_API_KEY has precedence.
# CLAUDE_API_KEY=
# ANTHROPIC_API_KEY=

# Research: reuse existing PERPLEXITY_API_KEY (Sonar) OR provide TAVILY_API_KEY.
# If both are configured, Tavily is used. No frontend keys, no mock production fallback.
# PERPLEXITY_API_KEY=
# TAVILY_API_KEY=

# Uses existing DATA_DIR persistent disk and existing admin-role authentication.
# API endpoints are fixed HTTPS; source pages restricted to manufacturer/government hosts.
# Default IST schedule: new 09:00, improve 13:00, new 17:00.
# Default budgets: 2 new / 1 improvement / 1 manual draft; 18 API call reservations,
# 300000 token reservations per day; 3 attempts/slot. Changes via admin controls.
# Research sources: at most 4 fetches/attempt, 2 retained, 6000 chars each.
# Generator uses existing claude-sonnet-4-5; research uses Sonar or Tavily basic.
# Configured provider = key presence ONLY, not current connectivity/credits/model access.
# Read-only diagnosis: GET /api/admin/auto-blogger with the existing admin session.
# Admin UI: /admin/auto-blogger (Content / Blog is the separate manual editor).
# Default reservation budget fits five complete attempts, NOT every possible retry.
# Remaining new-post first attempts are protected from optional work. Skips before
# research reserve nothing. Review budgetWarning in diagnostics; do not lower safety
# checks to meet quota. 21 calls / 420000 tokens could cover 3+1+3 attempts if approved;
# 27 / 540000 covers 3+3+3, excluding optional manual work. These are limits, not bills.
# Source redirect hops are capped at 3 and rechecked against the authority allowlist
# and public DNS; whole-source timeout 12 seconds, max 750000 bytes, HTML/text only.
# Only managed engine articles are eligible for improvement; legacy manual posts stay untouched.
