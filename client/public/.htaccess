DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Only the public GoDaddy hosts are canonicalized, never the Render bridge host.
  RewriteCond %{HTTP_HOST} ^www\.narmadamobility\.com$ [NC]
  RewriteRule ^ https://narmadamobility.com%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^narmadamobility\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://narmadamobility.com%{REQUEST_URI} [R=301,L,NE]
  RewriteRule ^(?:product(?:/.*)?|p(?:/.*)?|products/?)$ seo-bridge.php [END,QSA]
  RewriteRule ^(?:sitemap(?:-seo|-seo-index)?\.xml|robots\.txt)$ seo-bridge.php [END,QSA]

  # R28.18: read-only dynamic blog HTML/sitemap, BEFORE existing files so stale
  # prerendered blog directories cannot hide newly published articles.
  # No ProxyPass: PHP fetches only the fixed Render public-blog upstream.
  RewriteRule ^blog(?:/.*)?$ blog-bridge.php [END,QSA]
  RewriteRule ^sitemap-blog\.xml$ blog-bridge.php [END,QSA]

  # Serve existing files/directories as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Known app paths keep the SPA; unknown paths get a real noindex 404.
  RewriteRule ^ site-entry.php [END,QSA]
</IfModule>

<IfModule mod_headers.c>
  # Never cache the entry point or release marker so new deploys are identifiable.
  <FilesMatch "(?:index\.html|version\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Long-cache fingerprinted static assets.
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
